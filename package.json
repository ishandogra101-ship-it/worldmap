{
  "name": "worldmap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive historical world map: kingdoms, rulers, figures and events through time.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "build:borders": "node scripts/build-borders.mjs",
    "build:arcs": "node scripts/build-arcs.mjs",
    "import:wikidata": "node scripts/import/build-dataset.mjs",
    "audit:borders": "node scripts/audit/check-borders.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "mapshaper": "^0.6.102",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
